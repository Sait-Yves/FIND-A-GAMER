# Configuration Base de données (MySQL local via XAMPP)
# Format : mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:@localhost:3306/lobbygamer"

# Clé API RAWG (Obtenable gratuitement sur https://rawg.io/apidocs)
RAWG_API_KEY="votre_cle_api_rawg"
NEXT_PUBLIC_RAWG_API_KEY="votre_cle_api_rawg"

# Authentification (NextAuth / JWT)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="un_secret_ultra_securise_a_generer_avec_openssl_rand_base64_32"

# Notifications Push (WebPush / VAPID Keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="votre_cle_vapid_publique"
VAPID_PRIVATE_KEY="votre_cle_vapid_privee"
VAPID_SUBJECT="mailto:contact@lobbygamer.local"

# Environnement
NODE_ENV="development"
